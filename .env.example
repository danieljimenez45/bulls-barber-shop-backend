# ── Aplicación ────────────────────────────────────────────────────────────────
APP_NAME="Bulls Barber Shop"
DEBUG=false

# ── Base de datos ──────────────────────────────────────────────────────────────
# Desarrollo (SQLite):
DATABASE_URL=sqlite:///./bulls_barbershop.db
# Producción (PostgreSQL):
# DATABASE_URL=postgresql://user:password@host:5432/bulls_barbershop

# ── Seguridad ──────────────────────────────────────────────────────────────────
# Genera una clave segura con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ───────────────────────────────────────────────────────────────────────
# Dominio principal de producción (sin slash final):
PRODUCTION_DOMAIN=bullsbarbershop.es
# O lista completa de orígenes (JSON o separados por comas):
# CORS_ORIGINS=["https://bullsbarbershop.es","https://www.bullsbarbershop.es"]
# Desarrollo:
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Email / Notificaciones ─────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password
EMAIL_FROM=tu_correo@gmail.com
ADMIN_EMAIL=correo_de_jonathan@gmail.com
