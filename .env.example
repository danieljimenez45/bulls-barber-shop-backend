# ─────────────────────────────────────────────────────────────────────────────
# Bulls Barber Shop — Backend · Variables de entorno
#
# Copia este fichero a .env y rellena los valores reales.
# .env NUNCA se sube al repositorio (está en .gitignore).
#
# Genera SECRET_KEY con:
#   openssl rand -hex 32
#   # o:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────────────────────────────────────────

# ── Seguridad (obligatorio) ──────────────────────────────────────────────────
SECRET_KEY=cambia_esto_por_un_valor_generado_con_openssl_rand_hex_32

# ── Base de datos ────────────────────────────────────────────────────────────
# Desarrollo: SQLite (valor por defecto, no hace falta definirlo)
# DATABASE_URL=sqlite:///./bulls_barbershop.db
#
# Producción: PostgreSQL
# DATABASE_URL=postgresql+psycopg2://usuario:contraseña@host:5432/nombre_db

# ── CORS ─────────────────────────────────────────────────────────────────────
# Lista separada por comas o formato JSON.
# CORS_ORIGINS=https://bullsbarbershop.es,https://www.bullsbarbershop.es
# Dominio de producción (se añade automáticamente a CORS_ORIGINS):
# PRODUCTION_DOMAIN=bullsbarbershop.es

# ── Rate limiting ─────────────────────────────────────────────────────────────
# RATE_LIMIT_ENABLED=true
# Solo activa TRUST_PROXY_HEADERS si la API está detrás de nginx/Traefik
# que sobrescribe X-Forwarded-For de forma fiable:
# TRUST_PROXY_HEADERS=false

# ── Email / SMTP (opcional) ──────────────────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=usuario@example.com
# SMTP_PASSWORD=contraseña_smtp
# EMAIL_FROM=noreply@bullsbarbershop.es
# ADMIN_EMAIL=admin@bullsbarbershop.es

# ── Cloudinary — almacenamiento de imágenes en la nube (opcional) ────────────
# Si los tres valores están configurados se usa Cloudinary.
# Si alguno está vacío, se usa almacenamiento local (carpeta uploads/).
# CLOUDINARY_CLOUD_NAME=tu_cloud_name
# CLOUDINARY_API_KEY=tu_api_key
# CLOUDINARY_API_SECRET=tu_api_secret
# CLOUDINARY_FOLDER=bulls_barbershop
