# ── Aplicación ────────────────────────────────────────────────────────────────
APP_NAME="Bulls Barber Shop"
DEBUG=false

# ── Base de datos ──────────────────────────────────────────────────────────────
# Desarrollo (SQLite):
DATABASE_URL=sqlite:///./bulls_barbershop.db
# Producción (PostgreSQL):
# DATABASE_URL=postgresql://user:password@host:5432/bulls_barbershop

# ── Seguridad ──────────────────────────────────────────────────────────────────
# SECRET_KEY es OBLIGATORIA — la app no arranca sin ella.
# Genera un valor seguro con: openssl rand -hex 32
#                         o: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ───────────────────────────────────────────────────────────────────────
# Dominio principal de producción (sin slash final):
PRODUCTION_DOMAIN=bullsbarbershop.es
# O lista completa de orígenes (JSON o separados por comas):
# CORS_ORIGINS=["https://bullsbarbershop.es","https://www.bullsbarbershop.es"]
# Desarrollo:
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
# Poner false en entornos de test/desarrollo si molesta

# ── Email / Notificaciones ─────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password
EMAIL_FROM=tu_correo@gmail.com
ADMIN_EMAIL=correo_de_jonathan@gmail.com

# ── Cloudinary — almacenamiento de imágenes (B-26) ────────────────────────────
# Las imágenes de la galería se suben a Cloudinary en producción.
# Si estas tres variables están vacías se usa almacenamiento local (solo dev).
#
# Obtén tus credenciales en: https://console.cloudinary.com/
#   Dashboard → API Keys
#
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
# Carpeta dentro de tu cuenta Cloudinary:
CLOUDINARY_FOLDER=bulls_barbershop
